{
  "protocol_sha256": "63e244c76de28769ca28d0c8994acc988a5246559ca82944cd8dcbea361e6c33",
  "scenarios": ["acknowledged", "commit_ack_lost", "pending_then_commit", "failed_before_commit"],
  "tasks": [
