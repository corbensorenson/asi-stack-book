{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corbensorenson.github.io/asi-stack-book/schemas/manim_treatment.schema.json",
  "title": "ASI Stack Manim Editorial and Visual Treatment",
  "type": "object",
  "required": [
    "schema_version",
    "chapter_id",
    "chapter_sha256",
    "source_context_sha256",
    "source_commit",
    "audience",
    "promise_candidates",
    "teaching_promise",
    "selection_rationale",
    "content_contract",
    "story",
    "packaging",
    "art_direction",
    "audio_direction",
    "accessibility",
    "script_gate"
  ],
  "properties": {
    "schema_version": {"const": "asi_stack.manim_treatment.v1"},
    "chapter_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "chapter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "audience": {
      "type": "object",
      "required": [
        "target_viewer",
        "assumed_knowledge",
        "excluded_assumptions",
        "standalone_context",
        "introduced_terms"
      ],
      "properties": {
        "target_viewer": {"type": "string", "minLength": 16},
        "assumed_knowledge": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "excluded_assumptions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "standalone_context": {"type": "string", "minLength": 16},
        "introduced_terms": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        }
      },
      "additionalProperties": false
    },
    "promise_candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "promise",
          "consequence",
          "visual_mechanism",
          "transfer_value",
          "evidence_fit",
          "disposition",
          "rationale"
        ],
        "properties": {
          "promise": {"type": "string", "minLength": 12, "maxLength": 180},
          "consequence": {"type": "string", "minLength": 8},
          "visual_mechanism": {"type": "string", "minLength": 8},
          "transfer_value": {"type": "string", "minLength": 8},
          "evidence_fit": {"type": "string", "minLength": 8},
          "disposition": {"enum": ["selected", "rejected"]},
          "rationale": {"type": "string", "minLength": 12}
        },
        "additionalProperties": false
      }
    },
    "teaching_promise": {"type": "string", "minLength": 12, "maxLength": 180},
    "selection_rationale": {"type": "string", "minLength": 24},
    "content_contract": {
      "type": "object",
      "required": [
        "chapter_claim_ids",
        "source_ids",
        "non_claims",
        "case_assumptions",
        "notation_ledger",
        "truth_checks",
        "visual_simplifications"
      ],
      "properties": {
        "chapter_claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "non_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 12}
        },
        "case_assumptions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 8}
        },
        "notation_ledger": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["token", "meaning", "unit", "visual_form"],
            "properties": {
              "token": {"type": "string", "minLength": 1},
              "meaning": {"type": "string", "minLength": 3},
              "unit": {"type": ["string", "null"]},
              "visual_form": {"type": "string", "minLength": 3}
            },
            "additionalProperties": false
          }
        },
        "truth_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["statement", "authority_refs", "method", "result", "resolution"],
            "properties": {
              "statement": {"type": "string", "minLength": 12},
              "authority_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 3}
              },
              "method": {
                "enum": [
                  "chapter_text",
                  "source_note",
                  "lean",
                  "executable_model",
                  "manual_derivation"
                ]
              },
              "result": {"enum": ["pass", "fail", "uncertain"]},
              "resolution": {"type": ["string", "null"], "minLength": 12}
            },
            "allOf": [
              {
                "if": {
                  "properties": {"result": {"enum": ["fail", "uncertain"]}},
                  "required": ["result"]
                },
                "then": {"properties": {"resolution": {"type": "string", "minLength": 12}}}
              }
            ],
            "additionalProperties": false
          }
        },
        "visual_simplifications": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 8}
        }
      },
      "additionalProperties": false
    },
    "story": {
      "type": "object",
      "required": [
        "story_form",
        "story_basis",
        "concrete_case",
        "opening_question",
        "macro_moves",
        "payoff",
        "comprehension_question",
        "comprehension_success_criteria",
        "transfer_question",
        "transfer_success_criteria"
      ],
      "properties": {
        "story_form": {
          "enum": [
            "failure_diagnosis",
            "comparison",
            "direct_construction",
            "counterexample",
            "visual_proof",
            "open_question",
            "hybrid"
          ]
        },
        "story_basis": {
          "anyOf": [
            {
              "type": "object",
              "required": ["description", "authority_refs"],
              "properties": {
                "description": {"type": "string", "minLength": 16},
                "authority_refs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 3}
                }
              },
              "additionalProperties": false
            },
            {"type": "null"}
          ]
        },
        "concrete_case": {"type": "string", "minLength": 12},
        "opening_question": {"type": ["string", "null"], "minLength": 8},
        "macro_moves": {
          "type": "array",
          "minItems": 3,
          "maxItems": 7,
          "items": {
            "type": "object",
            "required": [
              "id", "purpose", "viewer_model_before", "visible_event",
              "viewer_model_after"
            ],
            "properties": {
              "id": {"type": "string", "pattern": "^m[0-9]{2}$"},
              "purpose": {"type": "string", "minLength": 8},
              "viewer_model_before": {"type": "string", "minLength": 12},
              "visible_event": {"type": "string", "minLength": 12},
              "viewer_model_after": {"type": "string", "minLength": 12}
            },
            "additionalProperties": false
          }
        },
        "payoff": {"type": "string", "minLength": 12},
        "comprehension_question": {"type": "string", "minLength": 16},
        "comprehension_success_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 8}
        },
        "transfer_question": {"type": "string", "minLength": 16},
        "transfer_success_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 8}
        }
      },
      "additionalProperties": false
    },
    "packaging": {
      "type": "object",
      "required": [
        "working_title",
        "thumbnail_concept",
        "thumbnail_alt_text",
        "promise_match",
        "first_fifteen_seconds_delivery",
        "source_delivery",
        "source_delivery_refs"
      ],
      "properties": {
        "working_title": {"type": "string", "minLength": 8, "maxLength": 100},
        "thumbnail_concept": {"type": "string", "minLength": 12},
        "thumbnail_alt_text": {"type": "string", "minLength": 12},
        "promise_match": {"type": "string", "minLength": 16},
        "first_fifteen_seconds_delivery": {"type": "string", "minLength": 16},
        "source_delivery": {"type": "string", "minLength": 16},
        "source_delivery_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        }
      },
      "additionalProperties": false
    },
    "art_direction": {
      "type": "object",
      "required": [
        "medium",
        "medium_rationale",
        "visual_thesis",
        "signature_image",
        "visual_world",
        "persistent_objects",
        "visual_invariants",
        "composition_rule",
        "palette_rule",
        "typography_rule",
        "motion_character",
        "camera_rule",
        "surface_rule",
        "ending_image",
        "semantic_keyframes",
        "asset_plan"
      ],
      "properties": {
        "medium": {
          "enum": [
            "manim_primary",
            "hybrid",
            "still_primary",
            "screen_recording_primary",
            "conventional_edit_primary"
          ]
        },
        "medium_rationale": {"type": "string", "minLength": 16},
        "visual_thesis": {"type": "string", "minLength": 12},
        "signature_image": {"type": "string", "minLength": 12},
        "visual_world": {"type": "string", "minLength": 12},
        "persistent_objects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "visual_invariants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 8}
        },
        "composition_rule": {"type": "string", "minLength": 8},
        "palette_rule": {"type": "string", "minLength": 8},
        "typography_rule": {"type": "string", "minLength": 8},
        "motion_character": {"type": "string", "minLength": 8},
        "camera_rule": {"type": "string", "minLength": 8},
        "surface_rule": {"type": "string", "minLength": 8},
        "ending_image": {"type": "string", "minLength": 12},
        "semantic_keyframes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 9,
          "items": {
            "type": "object",
            "required": [
              "id",
              "after_macro_move_id",
              "focal_state",
              "visible_invariant",
              "unresolved_question"
            ],
            "properties": {
              "id": {"type": "string", "pattern": "^k[0-9]{2}$"},
              "after_macro_move_id": {"type": ["string", "null"], "pattern": "^m[0-9]{2}$"},
              "focal_state": {"type": "string", "minLength": 12},
              "visible_invariant": {"type": "string", "minLength": 8},
              "unresolved_question": {"type": ["string", "null"], "minLength": 8}
            },
            "additionalProperties": false
          }
        },
        "asset_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "asset_id", "kind", "role", "path_or_source", "provenance",
              "license", "sha256", "security_review", "status"
            ],
            "properties": {
              "asset_id": {"type": "string", "minLength": 2},
              "kind": {"enum": ["bitmap", "vector", "video", "audio", "font", "data", "code", "other"]},
              "role": {"type": "string", "minLength": 8},
              "path_or_source": {"type": "string", "minLength": 3},
              "provenance": {"type": "string", "minLength": 12},
              "license": {"type": "string", "minLength": 3},
              "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "security_review": {"enum": ["planned", "pass", "not_applicable"]},
              "status": {"enum": ["original", "rights_cleared", "planned"]}
            },
            "allOf": [
              {
                "if": {"properties": {"status": {"const": "planned"}}, "required": ["status"]},
                "then": {
                  "properties": {
                    "sha256": {"type": "null"},
                    "security_review": {"const": "planned"}
                  }
                },
                "else": {
                  "properties": {
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "security_review": {"enum": ["pass", "not_applicable"]}
                  }
                }
              }
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "audio_direction": {
      "type": "object",
      "required": [
        "narration_style",
        "pacing_arc",
        "music_policy",
        "sound_effect_policy",
        "performance_blocks",
        "review_devices"
      ],
      "properties": {
        "narration_style": {"type": "string", "minLength": 8},
        "pacing_arc": {"type": "string", "minLength": 8},
        "music_policy": {"type": "string", "minLength": 8},
        "sound_effect_policy": {"type": "string", "minLength": 8},
        "duration_rationale": {"type": "string", "minLength": 24},
        "performance_blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["id", "macro_move_ids", "performance_direction", "pronunciation_items"],
            "properties": {
              "id": {"type": "string", "pattern": "^p[0-9]{2}$"},
              "macro_move_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^m[0-9]{2}$"}
              },
              "performance_direction": {"type": "string", "minLength": 12},
              "pronunciation_items": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          }
        },
        "review_devices": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        }
      },
      "additionalProperties": false
    },
    "accessibility": {
      "type": "object",
      "required": [
        "color_redundancy",
        "motion_redundancy",
        "integrated_description",
        "caption_plan",
        "descriptive_transcript_plan",
        "reduced_motion_assessment",
        "caption_safe_composition"
      ],
      "properties": {
        "color_redundancy": {"type": "string", "minLength": 8},
        "motion_redundancy": {"type": "string", "minLength": 8},
        "integrated_description": {"type": "string", "minLength": 8},
        "caption_plan": {"type": "string", "minLength": 8},
        "descriptive_transcript_plan": {"type": "string", "minLength": 8},
        "reduced_motion_assessment": {"type": "string", "minLength": 8},
        "caption_safe_composition": {"type": "string", "minLength": 8}
      },
      "additionalProperties": false
    },
    "script_gate": {
      "type": "object",
      "required": [
        "narration_path",
        "narration_sha256",
        "narration_word_count",
        "read_aloud_review",
        "truth_review",
        "visualizability_review",
        "reviewer_id",
        "verdict",
        "open_defects"
      ],
      "properties": {
        "narration_path": {"type": "string", "minLength": 8},
        "narration_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "narration_word_count": {"type": ["integer", "null"], "minimum": 1},
        "read_aloud_review": {"enum": ["not_started", "revise", "pass"]},
        "truth_review": {"enum": ["not_started", "revise", "pass"]},
        "visualizability_review": {"enum": ["not_started", "revise", "pass"]},
        "reviewer_id": {"type": ["string", "null"], "minLength": 3},
        "verdict": {"enum": ["not_reviewed", "revise", "pass"]},
        "open_defects": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 8}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
