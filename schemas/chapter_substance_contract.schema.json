{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corbensorenson.github.io/asi-stack-book/schemas/chapter_substance_contract.schema.json",
  "title": "Chapter Substance and Concept-Fidelity Contract",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "recorded_date",
    "manifest_path",
    "manifest_chapter_count_freeze",
    "word_count_method",
    "word_trigger",
    "concept_contract_rule",
    "atom_source_paths",
    "chapter_records",
    "summary",
    "manual_semantic_review_required",
    "chapter_growth_authority",
    "support_state_effect",
    "release_effect",
    "non_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "asi_stack.chapter_substance_contract.v1"
    },
    "contract_id": {
      "const": "P6.9-R20-chapter-substance-and-concept-fidelity"
    },
    "recorded_date": {
      "const": "2026-07-27"
    },
    "manifest_path": {
      "const": "book_structure.json"
    },
    "manifest_chapter_count_freeze": {
      "const": 84
    },
    "word_count_method": {
      "type": "string",
      "minLength": 50
    },
    "word_trigger": {
      "const": 5000
    },
    "concept_contract_rule": {
      "type": "string",
      "minLength": 120
    },
    "atom_source_paths": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "chapter_records": {
      "type": "array",
      "minItems": 84,
      "maxItems": 84,
      "items": {
        "$ref": "#/$defs/chapter"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "manual_semantic_review_required": {
      "const": true
    },
    "chapter_growth_authority": {
      "const": "frozen_at_84_until_thin_and_atom_debt_are_zero_or_terminally_justified"
    },
    "support_state_effect": {
      "const": "none"
    },
    "release_effect": {
      "const": "none"
    },
    "non_claims": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 20
      }
    }
  },
  "$defs": {
    "atom_ref": {
      "type": "object",
      "required": [
        "atom_id",
        "source_path"
      ],
      "properties": {
        "atom_id": {
          "type": "string",
          "minLength": 4
        },
        "source_path": {
          "type": "string",
          "minLength": 10
        }
      },
      "additionalProperties": false
    },
    "concept": {
      "type": "object",
      "required": [
        "concept_id",
        "heading",
        "source_ids",
        "minimum_section_words",
        "required_elements",
        "observed_section_words",
        "observed_elements",
        "source_ids_declared_by_chapter"
      ],
      "properties": {
        "concept_id": {
          "type": "string",
          "minLength": 3
        },
        "heading": {
          "type": "string",
          "minLength": 3
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "minimum_section_words": {
          "const": 150
        },
        "required_elements": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "observed_section_words": {
          "type": "integer",
          "minimum": 0
        },
        "observed_elements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "source_ids_declared_by_chapter": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "chapter": {
      "type": "object",
      "required": [
        "chapter_id",
        "chapter_title",
        "path",
        "sha256",
        "word_count",
        "word_trigger",
        "depth_state",
        "short_reference_exception",
        "short_reference_justification",
        "atom_refs",
        "concept_contracts"
      ],
      "properties": {
        "chapter_id": {
          "type": "string",
          "minLength": 1
        },
        "chapter_title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^chapters/.+\\.qmd$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "word_count": {
          "type": "integer",
          "minimum": 1
        },
        "word_trigger": {
          "const": 5000
        },
        "depth_state": {
          "enum": [
            "active_priority_concept_contract",
            "queued_thin_chapter_for_manual_concept_contract",
            "word_trigger_clear_semantic_certification_not_implied"
          ]
        },
        "short_reference_exception": {
          "const": false
        },
        "short_reference_justification": {
          "type": "null"
        },
        "atom_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/atom_ref"
          }
        },
        "concept_contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/concept"
          }
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "chapter_count",
        "thin_chapter_count",
        "active_priority_chapter_count",
        "queued_thin_chapter_count",
        "word_trigger_clear_chapter_count",
        "atom_covered_chapter_count",
        "atom_uncovered_chapter_count",
        "active_concept_count",
        "active_concepts_passing_count",
        "support_state_effect"
      ],
      "properties": {
        "chapter_count": {
          "const": 84
        },
        "thin_chapter_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 84
        },
        "active_priority_chapter_count": {
          "const": 3
        },
        "queued_thin_chapter_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 81
        },
        "word_trigger_clear_chapter_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 84
        },
        "atom_covered_chapter_count": {
          "const": 84
        },
        "atom_uncovered_chapter_count": {
          "const": 0
        },
        "active_concept_count": {
          "const": 24
        },
        "active_concepts_passing_count": {
          "const": 24
        },
        "support_state_effect": {
          "const": "none"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
