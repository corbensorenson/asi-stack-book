{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P5 effect-complete stateful service result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "system_id",
    "case_design_sha256",
    "case_count",
    "passed_case_count",
    "process_roles",
    "learning_state",
    "rollback",
    "external_effect",
    "custody",
    "receipts",
    "support_state_effect",
    "release_effect",
    "maximum_inference",
    "non_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "asi_stack.effect_complete_service_result.v1"
    },
    "result_id": {
      "const": "p5-effect-complete-stateful-service-2026-07-27"
    },
    "system_id": {
      "const": "p5-effect-complete-stateful-service-001"
    },
    "case_design_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "case_count": {
      "const": 7
    },
    "passed_case_count": {
      "const": 7
    },
    "process_roles": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "learning_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_class_count",
        "mutated_state_class_count",
        "training_steps",
        "loss_before",
        "loss_after",
        "positive_control_passed"
      ],
      "properties": {
        "state_class_count": {
          "const": 9
        },
        "mutated_state_class_count": {
          "const": 9
        },
        "training_steps": {
          "type": "integer",
          "minimum": 8
        },
        "loss_before": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "loss_after": {
          "type": "number",
          "minimum": 0
        },
        "positive_control_passed": {
          "const": true
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_selected_before_mutation",
        "artifact_only_control_rejected",
        "artifact_only_mismatched_state_classes",
        "crash_exit_code",
        "restart_process_used",
        "restored_state_class_count",
        "byte_exact_restore",
        "restored_prediction_exact"
      ],
      "properties": {
        "checkpoint_selected_before_mutation": {
          "const": true
        },
        "artifact_only_control_rejected": {
          "const": true
        },
        "artifact_only_mismatched_state_classes": {
          "type": "integer",
          "minimum": 8
        },
        "crash_exit_code": {
          "const": 17
        },
        "restart_process_used": {
          "const": true
        },
        "restored_state_class_count": {
          "const": 9
        },
        "byte_exact_restore": {
          "const": true
        },
        "restored_prediction_exact": {
          "const": true
        }
      }
    },
    "external_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition_attempt_failed_closed",
        "owned_outbox_count_during_partition",
        "accepted_effect_count",
        "duplicate_retry_count",
        "revoked_attempt_count",
        "revoked_effect_count",
        "independent_observer_process",
        "observer_digest_match",
        "open_unowned_effects"
      ],
      "properties": {
        "partition_attempt_failed_closed": {
          "const": true
        },
        "owned_outbox_count_during_partition": {
          "const": 1
        },
        "accepted_effect_count": {
          "const": 1
        },
        "duplicate_retry_count": {
          "const": 1
        },
        "revoked_attempt_count": {
          "const": 1
        },
        "revoked_effect_count": {
          "const": 0
        },
        "independent_observer_process": {
          "const": true
        },
        "observer_digest_match": {
          "const": true
        },
        "open_unowned_effects": {
          "const": 0
        }
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attested_source_commit",
        "attested_branch",
        "source_file_count",
        "source_files_match_commit",
        "source_file_sha256",
        "model_weight_digest_bound",
        "dependency_lock_digest_bound",
        "weight_tamper_rejected",
        "dependency_tamper_rejected",
        "attestation_scope"
      ],
      "properties": {
        "attested_source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "attested_branch": {
          "const": "main"
        },
        "source_file_count": {
          "type": "integer",
          "minimum": 3
        },
        "source_files_match_commit": {
          "const": true
        },
        "source_file_sha256": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "model_weight_digest_bound": {
          "const": true
        },
        "dependency_lock_digest_bound": {
          "const": true
        },
        "weight_tamper_rejected": {
          "const": true
        },
        "dependency_tamper_rejected": {
          "const": true
        },
        "attestation_scope": {
          "const": "local_source_and_runtime_identity_not_deployment"
        }
      }
    },
    "receipts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "passed",
          "terminal_disposition",
          "observations"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "passed": {
            "const": true
          },
          "terminal_disposition": {
            "type": "string"
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "support_state_effect": {
      "const": "none"
    },
    "release_effect": {
      "const": "none"
    },
    "maximum_inference": {
      "type": "string",
      "minLength": 120
    },
    "non_claims": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string"
      }
    }
  }
}
