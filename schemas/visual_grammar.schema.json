{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corbensorenson.github.io/asi-stack-book/schemas/visual_grammar.schema.json",
  "title": "ASI Stack Visual Grammar",
  "type": "object",
  "required": [
    "schema_version",
    "grammar_id",
    "state",
    "aspect_ratio",
    "canvas",
    "palette",
    "semantic_symbols",
    "typography",
    "motion",
    "contrast",
    "reusable_components",
    "accessibility",
    "ratification_gate",
    "support_state_effect",
    "non_claim"
  ],
  "properties": {
    "schema_version": {"const": "asi_stack.visual_grammar.v1"},
    "grammar_id": {"type": "string", "minLength": 12},
    "state": {"enum": ["candidate_until_five_pilots_pass", "ratified"]},
    "aspect_ratio": {"const": "16:9"},
    "canvas": {
      "type": "object",
      "required": [
        "release_width",
        "release_height",
        "safe_area_fraction",
        "minimum_text_height_pixels",
        "minimum_caption_safe_bottom_pixels"
      ],
      "properties": {
        "release_width": {"const": 1920},
        "release_height": {"const": 1080},
        "safe_area_fraction": {"type": "number", "minimum": 0.8, "maximum": 0.95},
        "minimum_text_height_pixels": {"type": "integer", "minimum": 38},
        "minimum_caption_safe_bottom_pixels": {"type": "integer", "minimum": 150}
      },
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "required": ["background", "surface", "ink", "muted", "accent", "copper", "authority", "evidence", "residual", "rollback", "boundary"],
      "propertyNames": {
        "enum": ["background", "surface", "ink", "muted", "accent", "copper", "authority", "evidence", "residual", "rollback", "boundary"]
      },
      "additionalProperties": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
    },
    "semantic_symbols": {"type": "object", "minProperties": 7},
    "typography": {
      "type": "object",
      "required": ["primary", "fallback", "monospace", "title_weight", "body_weight", "maximum_lines_per_card", "maximum_words_per_line"],
      "properties": {
        "primary": {"const": "Avenir Next"},
        "fallback": {"const": "Arial"},
        "monospace": {"const": "Menlo"},
        "title_weight": {"const": "demi_bold"},
        "body_weight": {"const": "regular"},
        "maximum_lines_per_card": {"type": "integer", "minimum": 1, "maximum": 5},
        "maximum_words_per_line": {"type": "integer", "minimum": 1, "maximum": 11}
      },
      "additionalProperties": false
    },
    "motion": {
      "type": "object",
      "required": ["default_transition_seconds", "minimum_hold_seconds", "maximum_camera_motion_degrees_per_second", "maximum_flashes_per_second", "meaning_must_survive_motion_disabled"],
      "properties": {
        "default_transition_seconds": {"type": "number", "minimum": 0.2},
        "minimum_hold_seconds": {"type": "number", "minimum": 1},
        "maximum_camera_motion_degrees_per_second": {"type": "number", "maximum": 30},
        "maximum_flashes_per_second": {"const": 0},
        "meaning_must_survive_motion_disabled": {"const": true},
        "reduced_motion_derivative_required_before_publication": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "contrast": {
      "type": "object",
      "required": [
        "normal_text_minimum_ratio",
        "large_text_minimum_ratio",
        "non_text_boundary_minimum_ratio",
        "background_roles",
        "normal_text_roles"
      ],
      "properties": {
        "normal_text_minimum_ratio": {"const": 4.5},
        "large_text_minimum_ratio": {"const": 3.0},
        "non_text_boundary_minimum_ratio": {"const": 3.0},
        "background_roles": {
          "const": ["background", "surface"]
        },
        "normal_text_roles": {
          "const": ["ink", "muted", "accent", "copper", "authority", "evidence", "residual", "rollback", "boundary"]
        }
      },
      "additionalProperties": false
    },
    "reusable_components": {
      "type": "array",
      "minItems": 13,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "accessibility": {
      "type": "object",
      "required": ["motion_never_sole_carrier", "color_never_sole_carrier", "reviewed_captions_required", "descriptive_transcript_required", "material_visual_changes_described", "thumbnail_alt_text_required", "source_end_card_spoken_or_transcribed"],
      "additionalProperties": {"const": true}
    },
    "ratification_gate": {"type": "object"},
    "support_state_effect": {"const": "none"},
    "non_claim": {"type": "string", "minLength": 30}
  },
  "additionalProperties": false
}
