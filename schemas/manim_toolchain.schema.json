{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corbensorenson.github.io/asi-stack-book/schemas/manim_toolchain.schema.json",
  "title": "ASI Stack Manim Toolchain",
  "type": "object",
  "required": [
    "schema_version",
    "toolchain_id",
    "qualification_state",
    "host",
    "python",
    "manim",
    "native_dependencies",
    "media_tools",
    "font_contract",
    "render_profiles",
    "requirements_lock_path",
    "requirements_lock_sha256",
    "configuration_path",
    "configuration_sha256",
    "visual_grammar_path",
    "visual_grammar_sha256",
    "broken_global_environment_allowed",
    "upgrade_gate",
    "support_state_effect",
    "release_effect",
    "non_claims"
  ],
  "properties": {
    "schema_version": {"const": "asi_stack.manim_toolchain.v1"},
    "toolchain_id": {"type": "string", "minLength": 12},
    "captured_at_utc": {"type": "string"},
    "qualification_state": {
      "enum": [
        "recorded_not_qualified",
        "qualified_for_non_latex_pilots",
        "qualified_for_all_pilots",
        "qualified_for_all_non_latex_chapters"
      ]
    },
    "host": {
      "type": "object",
      "required": ["operating_system", "operating_system_version", "operating_system_build", "architecture"],
      "properties": {
        "operating_system": {"const": "macOS"},
        "operating_system_version": {"type": "string"},
        "operating_system_build": {"type": "string"},
        "architecture": {"const": "arm64"}
      },
      "additionalProperties": false
    },
    "python": {
      "type": "object",
      "required": ["implementation", "version", "architecture", "environment_class", "canonical_relative_path"],
      "properties": {
        "implementation": {"const": "CPython"},
        "version": {"type": "string"},
        "architecture": {"const": "arm64"},
        "environment_class": {"const": "isolated_ignored_build_venv"},
        "canonical_relative_path": {"pattern": "^build/visual_edition/"}
      },
      "additionalProperties": false
    },
    "manim": {
      "type": "object",
      "required": ["distribution", "version", "renderer", "manimgl"],
      "properties": {
        "distribution": {"const": "Manim Community Edition"},
        "version": {"const": "0.20.1"},
        "renderer": {"const": "cairo"},
        "manimgl": {"const": false}
      },
      "additionalProperties": false
    },
    "native_dependencies": {
      "type": "object",
      "required": ["cairo", "pango", "ffmpeg", "latex", "dvisvgm"],
      "properties": {
        "cairo": {"type": "string"},
        "pango": {"type": "string"},
        "ffmpeg": {"type": "string"},
        "latex": {"type": "string"},
        "dvisvgm": {"type": "string"}
      },
      "additionalProperties": false
    },
    "media_tools": {
      "type": "object",
      "required": ["ffmpeg", "ffprobe"],
      "properties": {
        "ffmpeg": {
          "allOf": [
            {"$ref": "#/$defs/media_tool"},
            {
              "properties": {
                "path": {"const": "/opt/homebrew/bin/ffmpeg"},
                "sha256": {"const": "dfe6df9286909cc6a6bfbe867c8461fe79f732ce5ed996991ea2d43054b39b5e"}
              }
            }
          ]
        },
        "ffprobe": {
          "allOf": [
            {"$ref": "#/$defs/media_tool"},
            {
              "properties": {
                "path": {"const": "/opt/homebrew/bin/ffprobe"},
                "sha256": {"const": "6057aa35c4dc2686b5368680c36fe39df2ea82e8adca509d2b04994c65280642"}
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "font_contract": {
      "type": "object",
      "required": ["primary", "fallback", "monospace", "math_strategy_until_latex_qualification"],
      "properties": {
        "primary": {"const": "Avenir Next"},
        "fallback": {"const": "Arial"},
        "monospace": {"const": "Menlo"},
        "math_strategy_until_latex_qualification": {"const": "pango_unicode_and_prevalidated_svg_only"}
      },
      "additionalProperties": false
    },
    "render_profiles": {
      "type": "object",
      "required": ["draft", "release"],
      "properties": {
        "draft": {
          "type": "object",
          "required": ["pixel_width", "pixel_height", "frame_rate", "quality_flag"],
          "properties": {
            "pixel_width": {"const": 854},
            "pixel_height": {"const": 480},
            "frame_rate": {"const": 15},
            "quality_flag": {"const": "-ql"}
          },
          "additionalProperties": false
        },
        "release": {
          "type": "object",
          "required": ["pixel_width", "pixel_height", "frame_rate", "quality_flag", "video_codec", "pixel_format"],
          "properties": {
            "pixel_width": {"const": 1920},
            "pixel_height": {"const": 1080},
            "frame_rate": {"const": 30},
            "quality_flag": {"const": "none_use_exact_config"},
            "video_codec": {"const": "h264"},
            "pixel_format": {"const": "yuv420p"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "requirements_lock_path": {"const": "visual_edition/requirements.lock.txt"},
    "requirements_lock_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "configuration_path": {"const": "visual_edition/manim.cfg"},
    "configuration_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "visual_grammar_path": {"const": "visual_edition/visual_grammar.json"},
    "visual_grammar_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "broken_global_environment_allowed": {"const": false},
    "upgrade_gate": {"type": "string", "minLength": 20},
    "support_state_effect": {"const": "none"},
    "release_effect": {"const": "none"},
    "non_claims": {"type": "array", "minItems": 4, "items": {"type": "string"}}
  },
  "$defs": {
    "media_tool": {
      "type": "object",
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "version": {"const": "8.0.1"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
