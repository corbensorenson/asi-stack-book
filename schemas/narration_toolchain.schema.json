{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corbensorenson.github.io/asi-stack-book/schemas/narration_toolchain.schema.json",
  "title": "ASI Stack Narration Toolchain",
  "type": "object",
  "required": [
    "schema_version",
    "toolchain_id",
    "qualification_state",
    "runtime",
    "synthesis",
    "verification",
    "alignment",
    "tracked_inputs",
    "rights_and_disclosure",
    "execution_boundary",
    "storage_boundary",
    "upgrade_gate",
    "non_claims"
  ],
  "properties": {
    "schema_version": {"const": "asi_stack.narration_toolchain.v1"},
    "toolchain_id": {"type": "string", "minLength": 20},
    "qualification_state": {
      "enum": [
        "candidate",
        "qualified_for_five_pilot_production",
        "qualified_for_all_chapters"
      ]
    },
    "runtime": {
      "type": "object",
      "required": [
        "operating_system", "architecture", "python", "environment_class",
        "canonical_relative_path"
      ],
      "properties": {
        "operating_system": {"const": "macOS"},
        "architecture": {"const": "arm64"},
        "python": {"const": "3.12.5"},
        "environment_class": {"const": "ignored_build_venv_not_os_sandbox"},
        "canonical_relative_path": {"const": "build/visual_edition/tts_venv/bin/python"}
      },
      "additionalProperties": false
    },
    "synthesis": {
      "type": "object",
      "required": [
        "implementation",
        "version",
        "implementation_license",
        "implementation_url",
        "model_repository",
        "model_revision",
        "upstream_model_repository",
        "model_license",
        "model_url",
        "model_directory",
        "config_sha256",
        "weights_sha256",
        "voice",
        "voice_sha256",
        "speed",
        "sample_rate",
        "channels",
        "language",
        "sample_format",
        "integrated_lufs_target",
        "true_peak_dbtp_target",
        "maximum_verified_true_peak_dbtp",
        "loudness_range_target",
        "sentence_pause_seconds",
        "paragraph_pause_seconds",
        "maximum_segment_characters",
        "normalizer_implementation",
        "normalizer_path",
        "normalizer_version",
        "normalizer_sha256"
      ],
      "properties": {
        "implementation": {"const": "kokoro-mlx"},
        "version": {"const": "0.1.2"},
        "implementation_license": {"const": "MIT"},
        "implementation_url": {"type": "string", "pattern": "^https://"},
        "model_repository": {"type": "string", "minLength": 8},
        "upstream_model_repository": {"type": "string", "minLength": 8},
        "model_license": {"const": "Apache-2.0"},
        "model_url": {"type": "string", "pattern": "^https://"},
        "model_directory": {"const": "build/visual_edition/models/Kokoro-82M-bf16"},
        "model_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "weights_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "voice": {"type": "string", "minLength": 3},
        "voice_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "speed": {"type": "number", "minimum": 0.8, "maximum": 1.3},
        "sample_rate": {"const": 24000},
        "channels": {"const": 1},
        "language": {"const": "en-US"},
        "sample_format": {"const": "PCM_24"},
        "integrated_lufs_target": {"const": -16.0},
        "true_peak_dbtp_target": {"const": -1.5},
        "maximum_verified_true_peak_dbtp": {"const": -1.0},
        "loudness_range_target": {"const": 11.0},
        "sentence_pause_seconds": {"const": 0.22},
        "paragraph_pause_seconds": {"const": 0.48},
        "maximum_segment_characters": {"const": 300},
        "normalizer_implementation": {"const": "ffmpeg_loudnorm_single_pass"},
        "normalizer_path": {"const": "/opt/homebrew/bin/ffmpeg"},
        "normalizer_version": {"const": "8.0.1"},
        "normalizer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "implementation",
        "version",
        "implementation_license",
        "implementation_url",
        "model_repository",
        "model_revision",
        "model_config_sha256",
        "model_weights_sha256",
        "maximum_content_normalized_word_error_rate",
        "required_checks"
      ],
      "properties": {
        "implementation": {"const": "mlx-whisper"},
        "version": {"const": "0.4.3"},
        "implementation_license": {"const": "MIT"},
        "implementation_url": {"type": "string", "pattern": "^https://"},
        "model_repository": {"type": "string", "minLength": 8},
        "model_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "model_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_weights_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "maximum_content_normalized_word_error_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.05
        },
        "required_checks": {"type": "array", "minItems": 6, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "alignment": {
      "type": "object",
      "required": [
        "qualification_state",
        "animatic_timing_source",
        "picture_and_sound_lock_requirement",
        "candidate_methods",
        "admission_test",
        "qualified_scope",
        "accepted_aligner_id",
        "aligner_script",
        "aligner_script_sha256",
        "requirements_lock",
        "requirements_lock_sha256",
        "pilot_receipts",
        "pilot_summary",
        "manual_review",
        "residual_policy"
      ],
      "properties": {
        "qualification_state": {
          "enum": ["not_yet_qualified", "qualified"]
        },
        "animatic_timing_source": {"type": "string", "minLength": 20},
        "picture_and_sound_lock_requirement": {"type": "string", "minLength": 40},
        "candidate_methods": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "admission_test": {"type": "string", "minLength": 60},
        "qualified_scope": {"const": "phrase anchors, caption lines, and generation-block joins only"},
        "accepted_aligner_id": {"const": "stable-ts-2.19.1-mlx-whisper-exact-text-phrase-v1"},
        "aligner_script": {"const": "skills/asi-stack-manim-videos/scripts/align_visual_narration.py"},
        "aligner_script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "requirements_lock": {"const": "visual_edition/alignment_requirements.lock.txt"},
        "requirements_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pilot_receipts": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["chapter_id", "path", "sha256", "verdict"],
            "properties": {
              "chapter_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              "path": {"type": "string", "pattern": "^visual_edition/chapters/.+/generation-2/receipts/alignment\\.json$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "verdict": {"const": "pass"}
            },
            "additionalProperties": false
          }
        },
        "pilot_summary": {
          "type": "object",
          "required": [
            "chapter_count", "normalized_term_count", "sync_anchor_count",
            "generation_join_count", "failure_count", "maximum_instant_word_fraction"
          ],
          "properties": {
            "chapter_count": {"type": "integer", "minimum": 4},
            "normalized_term_count": {"type": "integer", "minimum": 1000},
            "sync_anchor_count": {"type": "integer", "minimum": 20},
            "generation_join_count": {"type": "integer", "minimum": 20},
            "failure_count": {"const": 0},
            "maximum_instant_word_fraction": {"type": "number", "minimum": 0, "maximum": 0.025}
          },
          "additionalProperties": false
        },
        "manual_review": {
          "type": "object",
          "required": [
            "reviewer_id", "review_mode", "reviewed_chapter_count",
            "reviewed_anchor_count", "failure_count", "independent_human_review_claimed"
          ],
          "properties": {
            "reviewer_id": {"type": "string", "minLength": 6},
            "review_mode": {"const": "full-speed auditory phrase-window review"},
            "reviewed_chapter_count": {"type": "integer", "minimum": 4},
            "reviewed_anchor_count": {"type": "integer", "minimum": 12},
            "failure_count": {"const": 0},
            "independent_human_review_claimed": {"const": false}
          },
          "additionalProperties": false
        },
        "residual_policy": {"type": "string", "minLength": 100}
      },
      "additionalProperties": false
    },
    "tracked_inputs": {
      "type": "object",
      "required": [
        "requirements_lock", "requirements_lock_sha256",
        "pronunciation_lexicon", "pronunciation_lexicon_sha256",
        "renderer", "renderer_sha256",
        "transcription_runner", "transcription_runner_sha256",
        "caption_builder", "caption_builder_sha256",
        "narration_validator", "narration_validator_sha256",
        "visual_master_validator", "visual_master_validator_sha256"
      ],
      "properties": {
        "requirements_lock": {"const": "visual_edition/narration_requirements.lock.txt"},
        "requirements_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pronunciation_lexicon": {"const": "visual_edition/narration_pronunciations.json"},
        "pronunciation_lexicon_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "renderer": {"const": "scripts/render_visual_narration.py"},
        "renderer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "transcription_runner": {"const": "scripts/transcribe_visual_narrations.py"},
        "transcription_runner_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "caption_builder": {"const": "scripts/build_visual_captions_from_narration_receipt.py"},
        "caption_builder_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "narration_validator": {"const": "scripts/validate_visual_narration.py"},
        "narration_validator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "visual_master_validator": {"const": "scripts/validate_visual_master.py"},
        "visual_master_validator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "rights_and_disclosure": {
      "type": "object",
      "required": [
        "publication_rights_state",
        "required_video_description_disclosure",
        "human_voice_impersonation_claimed",
        "warranty_claimed"
      ],
      "properties": {
        "publication_rights_state": {
          "const": "cleared_under_recorded_open_source_and_model_licenses"
        },
        "required_video_description_disclosure": {"type": "string", "minLength": 40},
        "human_voice_impersonation_claimed": {"const": false},
        "warranty_claimed": {"const": false}
      },
      "additionalProperties": false
    },
    "execution_boundary": {
      "type": "object",
      "required": [
        "trust_model", "model_serialization", "remote_code_loading",
        "network_isolation", "credential_isolation", "acceptance_scope",
        "residual_risk"
      ],
      "properties": {
        "trust_model": {"const": "pinned_local_runtime_is_part_of_the_trusted_computing_base"},
        "model_serialization": {"const": "digest_bound_json_safetensors_and_npz"},
        "remote_code_loading": {"const": false},
        "network_isolation": {"const": "offline_library_hints_only_not_os_enforced"},
        "credential_isolation": {"const": "not_claimed"},
        "acceptance_scope": {"const": "audio_identity_content_agreement_and_recorded_rights_only"},
        "residual_risk": {"type": "string", "minLength": 80}
      },
      "additionalProperties": false
    },
    "storage_boundary": {
      "type": "object",
      "required": ["tracked", "ignored", "pages_artifact_may_contain_media"],
      "properties": {
        "tracked": {"type": "string", "minLength": 20},
        "ignored": {"type": "string", "minLength": 20},
        "pages_artifact_may_contain_media": {"const": false}
      },
      "additionalProperties": false
    },
    "upgrade_gate": {"type": "string", "minLength": 40},
    "non_claims": {"type": "array", "minItems": 5, "uniqueItems": true}
  },
  "additionalProperties": false
}
