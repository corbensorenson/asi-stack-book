{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corbensorenson.github.io/asi-stack-book/schemas/c6_remaining_stronger_model_audit.schema.json",
  "title": "C6 remaining stronger-model audit",
  "type": "object",
  "required": [
    "schema_version",
    "as_of",
    "state",
    "roadmap_lane",
    "source_overlay",
    "decision_policy",
    "summary",
    "execution_order",
    "records",
    "non_claims",
    "support_state_effect",
    "release_effect"
  ],
  "properties": {
    "schema_version": {"const": "asi_stack.c6_remaining_stronger_model_audit.v1"},
    "as_of": {"const": "2026-07-26"},
    "state": {"const": "terminal_triage_execution_pending"},
    "roadmap_lane": {"const": "C6-P0-P6-semantic-proof-rationalization"},
    "source_overlay": {
      "type": "object",
      "required": ["commit", "path", "sha256", "live_theorem_count", "pending_stronger_model_count"],
      "properties": {
        "commit": {"const": "9349d519130f37c86f319cd94147e57e3848b819"},
        "path": {"const": "proofs/proof_semantic_depth_overlay.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "live_theorem_count": {"type": "integer", "minimum": 1},
        "pending_stronger_model_count": {"const": 54}
      }
    },
    "decision_policy": {"type": "object"},
    "summary": {
      "type": "object",
      "required": [
        "record_count",
        "retire_without_replacement_count",
        "rewrite_as_inverse_route_property_count",
        "module_count",
        "action_counts",
        "module_counts",
        "theorem_dependency_count",
        "theorem_consumer_count",
        "new_formal_claim_count"
      ],
      "properties": {
        "record_count": {"const": 54},
        "retire_without_replacement_count": {"const": 53},
        "rewrite_as_inverse_route_property_count": {"const": 1},
        "module_count": {"const": 8},
        "theorem_dependency_count": {"const": 0},
        "theorem_consumer_count": {"const": 0},
        "new_formal_claim_count": {"const": 1}
      }
    },
    "execution_order": {"type": "array", "minItems": 4, "maxItems": 4},
    "records": {
      "type": "array",
      "minItems": 54,
      "maxItems": 54,
      "items": {
        "type": "object",
        "required": [
          "theorem_id",
          "module_path",
          "name",
          "semantic_owner_ids",
          "current_semantic_level",
          "current_syntax_depth_class",
          "theorem_dependency_refs",
          "theorem_consumer_refs",
          "executable_or_result_refs",
          "current_maximum_inference",
          "recommended_action",
          "recommended_action_rationale",
          "target_treatment",
          "execution_tranche",
          "new_formal_claim_required",
          "support_state_effect"
        ],
        "properties": {
          "theorem_id": {"type": "string", "minLength": 1},
          "module_path": {"type": "string", "pattern": "^lean/AsiStackProofs/.+\\.lean$"},
          "name": {"type": "string", "minLength": 1},
          "semantic_owner_ids": {"type": "array", "minItems": 1},
          "current_semantic_level": {"pattern": "^P[0-6]$"},
          "current_syntax_depth_class": {"type": "string", "minLength": 1},
          "theorem_dependency_refs": {"type": "array", "maxItems": 0},
          "theorem_consumer_refs": {"type": "array", "maxItems": 0},
          "executable_or_result_refs": {"type": "array"},
          "current_maximum_inference": {"type": "string", "minLength": 1},
          "recommended_action": {
            "enum": [
              "retire_redundant_fixture_witness",
              "retire_repository_fixture_mirror",
              "retire_summary_fixture_mirror",
              "rewrite_as_inverse_route_property"
            ]
          },
          "recommended_action_rationale": {"type": "string", "minLength": 1},
          "target_treatment": {"type": "string", "minLength": 1},
          "execution_tranche": {"type": "integer", "minimum": 1, "maximum": 4},
          "new_formal_claim_required": {"type": "boolean"},
          "support_state_effect": {"const": "none"}
        }
      }
    },
    "non_claims": {"type": "array", "minItems": 4},
    "support_state_effect": {"const": "none"},
    "release_effect": {"const": "none"}
  }
}
