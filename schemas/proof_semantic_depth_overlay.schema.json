{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corbensorenson.github.io/asi-stack-book/schemas/proof_semantic_depth_overlay.schema.json",
  "title": "ASI Stack current proof semantic-depth overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "roadmap_lane",
    "state",
    "generated_from",
    "level_definitions",
    "classification_policy",
    "summary",
    "records",
    "non_claims"
  ],
  "properties": {
    "schema_version": {"const": "asi_stack.proof_semantic_depth_overlay.v1"},
    "as_of": {"type": "string", "format": "date"},
    "roadmap_lane": {"const": "C6-P0-P6-semantic-proof-rationalization"},
    "state": {"const": "current_live_estate_classified_before_new_formal_expansion"},
    "generated_from": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "level_definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["P0", "P1", "P2", "P3", "P4", "P5", "P6"],
      "properties": {
        "P0": {"type": "string", "minLength": 1},
        "P1": {"type": "string", "minLength": 1},
        "P2": {"type": "string", "minLength": 1},
        "P3": {"type": "string", "minLength": 1},
        "P4": {"type": "string", "minLength": 1},
        "P5": {"type": "string", "minLength": 1},
        "P6": {"type": "string", "minLength": 1}
      }
    },
    "classification_policy": {"type": "object"},
    "summary": {
      "type": "object",
      "required": [
        "current_theorem_count",
        "current_module_count",
        "semantic_owner_chapter_count",
        "semantic_level_counts",
        "disposition_counts",
        "review_basis_counts",
        "implementation_binding_counts",
        "witness_state_counts",
        "duplicate_group_count",
        "cross_module_literal_pattern_group_count",
        "support_state_effect"
      ]
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    },
    "non_claims": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theorem_id",
        "module_path",
        "name",
        "source_start_line",
        "source_end_line",
        "current_signature",
        "current_block_sha256",
        "syntax_depth_class",
        "syntax_depth_evidence",
        "semantic_level",
        "semantic_level_meaning",
        "classification_basis",
        "semantic_owner_ids",
        "ownership_basis",
        "assumptions",
        "candidate_target_refs",
        "theorem_dependency_refs",
        "theorem_consumer_refs",
        "consumer_refs",
        "witness",
        "implementation_binding",
        "mutation_refs",
        "countermodel_refs",
        "empirical_observation_contract_refs",
        "maximum_inference",
        "disposition",
        "duplicate_of",
        "duplicate_kind",
        "disposition_rationale",
        "review_basis",
        "support_state_effect"
      ],
      "properties": {
        "theorem_id": {"type": "string", "minLength": 1},
        "module_path": {"type": "string", "pattern": "^lean/AsiStackProofs/.+\\.lean$"},
        "name": {"type": "string", "minLength": 1},
        "source_start_line": {"type": "integer", "minimum": 1},
        "source_end_line": {"type": "integer", "minimum": 1},
        "current_signature": {"type": "string", "minLength": 1},
        "current_block_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "syntax_depth_class": {
          "enum": ["direct_or_projection", "derived_or_decomposed", "unknown_or_mixed"]
        },
        "syntax_depth_evidence": {"type": "string", "minLength": 1},
        "semantic_level": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6"]},
        "semantic_level_meaning": {"type": "string", "minLength": 1},
        "classification_basis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "semantic_owner_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "ownership_basis": {"type": "string", "minLength": 1},
        "assumptions": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "candidate_target_refs": {"$ref": "#/$defs/stringArray"},
        "theorem_dependency_refs": {"$ref": "#/$defs/stringArray"},
        "theorem_consumer_refs": {"$ref": "#/$defs/stringArray"},
        "consumer_refs": {"$ref": "#/$defs/stringArray"},
        "witness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "refs", "rationale"],
          "properties": {
            "state": {
              "enum": [
                "bounded_local_witness_present",
                "explicit_formal_unreachability_only",
                "no_reachable_witness_identified"
              ]
            },
            "refs": {"$ref": "#/$defs/stringArray"},
            "rationale": {"type": "string", "minLength": 1}
          }
        },
        "implementation_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "validator_refs", "artifact_refs"],
          "properties": {
            "state": {
              "enum": ["validator_and_artifact_bound", "validator_only", "formal_model_only"]
            },
            "validator_refs": {"$ref": "#/$defs/stringArray"},
            "artifact_refs": {"$ref": "#/$defs/stringArray"}
          }
        },
        "mutation_refs": {"$ref": "#/$defs/stringArray"},
        "countermodel_refs": {"$ref": "#/$defs/stringArray"},
        "empirical_observation_contract_refs": {"$ref": "#/$defs/stringArray"},
        "maximum_inference": {"type": "string", "minLength": 1},
        "disposition": {
          "enum": [
            "retain",
            "rewrite_scope_language",
            "rewrite_with_stronger_model",
            "retire_duplicate",
            "retire_narrow_projection",
            "retire_unused_candidate"
          ]
        },
        "duplicate_of": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "duplicate_kind": {
          "anyOf": [
            {"type": "null"},
            {
              "enum": [
                "exact_normalized_statement",
                "reviewed_semantic_duplicate"
              ]
            }
          ]
        },
        "disposition_rationale": {"type": "string", "minLength": 1},
        "review_basis": {
          "enum": [
            "inherited_semantic_review_reprojected_to_current_overlay",
            "current_module_semantic_cluster_review",
            "current_validator_contract_review",
            "current_manual_semantic_spot_check",
            "conservative_current_machine_classification"
          ]
        },
        "support_state_effect": {"const": "none"}
      }
    }
  }
}
