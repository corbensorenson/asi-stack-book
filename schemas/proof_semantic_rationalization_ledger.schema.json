{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corbensorenson.github.io/asi-stack-book/schemas/proof_semantic_rationalization_ledger.schema.json",
  "title": "ASI Stack C6 cumulative proof semantic-rationalization ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "roadmap_lane",
    "state",
    "classification_baseline",
    "actions",
    "summary",
    "non_claims",
    "support_state_effect",
    "release_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "asi_stack.proof_semantic_rationalization_ledger.v3"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "roadmap_lane": {
      "const": "C6-P0-P6-semantic-proof-rationalization"
    },
    "state": {
      "const": "dependency_safe_execution_active"
    },
    "classification_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "overlay_path",
        "overlay_sha256",
        "live_theorem_count",
        "rewrite_or_retire_count"
      ],
      "properties": {
        "commit": {
          "const": "d0f9bda14f1253999f2c40d556d925d31e4b36a4"
        },
        "overlay_path": {
          "const": "proofs/proof_semantic_depth_overlay.json"
        },
        "overlay_sha256": {
          "const": "97ea98621611839c49c4056c85b52ae5a907e683ea2e8572efe642774492340a"
        },
        "live_theorem_count": {
          "const": 1370
        },
        "rewrite_or_retire_count": {
          "const": 161
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 42,
      "maxItems": 42,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed_retirement_count",
        "current_live_theorem_count",
        "remaining_action_count",
        "remaining_action_counts",
        "chapter_core_support_transitions",
        "new_formal_claims"
      ],
      "properties": {
        "executed_retirement_count": {
          "const": 42
        },
        "current_live_theorem_count": {
          "const": 1328
        },
        "remaining_action_count": {
          "const": 119
        },
        "remaining_action_counts": {
          "const": {
            "retire_narrow_projection": 22,
            "rewrite_scope_language": 2,
            "rewrite_with_stronger_model": 95
          }
        },
        "chapter_core_support_transitions": {
          "const": 0
        },
        "new_formal_claims": {
          "const": 0
        }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "support_state_effect": {
      "const": "none"
    },
    "release_effect": {
      "const": "none"
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "targetMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_ref",
        "old_target_text",
        "new_target_text",
        "consumer_paths"
      ],
      "properties": {
        "target_ref": {
          "type": "string",
          "pattern": "^proof-target:"
        },
        "old_target_text": {
          "type": "string",
          "minLength": 1
        },
        "new_target_text": {
          "type": "string",
          "minLength": 1
        },
        "consumer_paths": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "sequence",
        "state",
        "action",
        "semantic_relation",
        "module_path",
        "baseline_module_sha256",
        "retired_theorem_id",
        "replacement_theorem_id",
        "retired_block_sha256",
        "replacement_block_sha256",
        "retired_statement_sha256",
        "replacement_statement_sha256",
        "semantic_basis",
        "dependency_check",
        "target_migrations",
        "maximum_inference_preserved",
        "validation_refs",
        "support_state_effect"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^C6-R[1-9][0-9]*-"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "const": "executed"
        },
        "action": {
          "enum": [
            "retire_exact_same_model_duplicate",
            "retire_projection_after_counterexample_consumer_migration",
            "retire_projection_after_decision_model_consumer_migration",
            "retire_projection_after_public_target_narrowing",
            "retire_unconsumed_projection",
            "retire_projection_after_validator_route_family_rebinding"
          ]
        },
        "semantic_relation": {
          "enum": [
            "exact_same_model_normalized_statement",
            "premise_restatement_replaced_by_derived_counterexample_gate",
            "premise_restatement_replaced_by_derived_decision_gate",
            "premise_restatement_retired_after_target_scope_reduction",
            "premise_restatement_removed_without_public_target_change",
            "summary_projection_replaced_by_route_family_validation"
          ]
        },
        "module_path": {
          "type": "string",
          "pattern": "^lean/AsiStackProofs/.+\\.lean$"
        },
        "baseline_module_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retired_theorem_id": {
          "type": "string",
          "pattern": "^lean/AsiStackProofs/.+\\.lean::.+$"
        },
        "replacement_theorem_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^lean/AsiStackProofs/.+\\.lean::.+$"
        },
        "retired_block_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "replacement_block_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "retired_statement_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "replacement_statement_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "semantic_basis": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependency_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "same_module",
            "retired_theorem_dependency_refs",
            "retired_theorem_consumer_refs",
            "current_fully_qualified_consumer_refs"
          ],
          "properties": {
            "same_module": {
              "const": true
            },
            "retired_theorem_dependency_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "retired_theorem_consumer_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "current_fully_qualified_consumer_refs": {
              "const": []
            }
          }
        },
        "target_migrations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/targetMigration"
          }
        },
        "maximum_inference_preserved": {
          "type": "string",
          "minLength": 1
        },
        "validation_refs": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "support_state_effect": {
          "const": "none"
        }
      }
    }
  }
}
