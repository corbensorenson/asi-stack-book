{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corbensorenson.com/asi-stack/schemas/manim_alignment_review.schema.json",
  "title": "ASI Stack manual phrase-alignment review",
  "type": "object",
  "required": [
    "schema_version", "reviewed_at_utc", "chapter_id", "reviewer",
    "audio", "alignment_receipt", "method", "anchors", "summary",
    "independent_human_review_claimed", "support_state_effect",
    "publication_effect", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "asi_stack.manim_alignment_review.v1"},
    "reviewed_at_utc": {"type": "string", "format": "date-time"},
    "chapter_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "review_mode"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 6},
        "review_mode": {"const": "full-speed auditory phrase-window review"}
      },
      "additionalProperties": false
    },
    "audio": {"$ref": "#/$defs/bound_file"},
    "alignment_receipt": {"$ref": "#/$defs/bound_file"},
    "method": {"type": "string", "minLength": 80},
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "beat_id", "phrase", "start_seconds", "end_seconds",
          "pre_roll_seconds", "post_roll_seconds", "content_match",
          "onset_enclosed", "offset_enclosed", "clipped", "verdict"
        ],
        "properties": {
          "beat_id": {"type": "string", "pattern": "^b[0-9]{2,3}$"},
          "phrase": {"type": "string", "minLength": 3},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "pre_roll_seconds": {"type": "number", "minimum": 0.25},
          "post_roll_seconds": {"type": "number", "minimum": 0.25},
          "content_match": {"type": "boolean"},
          "onset_enclosed": {"type": "boolean"},
          "offset_enclosed": {"type": "boolean"},
          "clipped": {"type": "boolean"},
          "verdict": {"enum": ["pass", "fail"]}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["reviewed_anchor_count", "failure_count", "verdict"],
      "properties": {
        "reviewed_anchor_count": {"type": "integer", "minimum": 1},
        "failure_count": {"type": "integer", "minimum": 0},
        "verdict": {"enum": ["pass", "revise"]}
      },
      "additionalProperties": false
    },
    "independent_human_review_claimed": {"const": false},
    "support_state_effect": {"const": "none"},
    "publication_effect": {"const": "none"},
    "limitations": {"type": "string", "minLength": 80}
  },
  "additionalProperties": false,
  "$defs": {
    "bound_file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 8},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  }
}
