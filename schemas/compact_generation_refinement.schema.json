{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-asi-stack.org/schemas/compact_generation_refinement.schema.json",
  "title": "Compact Generation Refinement Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_id", "recorded_date", "command", "model", "source_result_refinement", "route_cases", "mutation_receipts", "witness", "verification", "support_state_effect", "external_effect", "residuals", "non_claims"],
  "properties": {
    "schema_version": {"const": "asi_stack.compact_generation_refinement.result.v2"},
    "result_id": {"const": "2026-07-15-compact-generation-refinement"},
    "recorded_date": {"const": "2026-07-15"},
    "command": {"const": "python3 scripts/validate_compact_generation_refinement.py"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lean_module", "stage_count", "stages", "lean_theorem_count", "lean_theorem_surface", "route_count", "independently_reached_route_count", "trace_event_count", "trace_composition_split_count", "identity_field_count", "identity_preservation_check_count", "non_authority_preservation_check_count", "fallback_monotonicity_check_count", "terminal_rejection_count", "mutation_count", "rejected_mutation_count", "route_case_count", "fallback_route_reached", "support_assignment_count", "external_effect_count"],
      "properties": {
        "lean_module": {"const": "lean/AsiStackProofs/CompactGenerationRefinement.lean"},
        "stage_count": {"const": 9},
        "stages": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"type": "string"}},
        "lean_theorem_count": {"const": 35},
        "lean_theorem_surface": {"type": "array", "minItems": 35, "maxItems": 35, "uniqueItems": true, "items": {"type": "string"}},
        "route_count": {"const": 60},
        "independently_reached_route_count": {"const": 60},
        "trace_event_count": {"const": 8},
        "trace_composition_split_count": {"const": 9},
        "identity_field_count": {"const": 10},
        "identity_preservation_check_count": {"const": 9},
        "non_authority_preservation_check_count": {"const": 9},
        "fallback_monotonicity_check_count": {"const": 8},
        "terminal_rejection_count": {"const": 8},
        "mutation_count": {"const": 163},
        "rejected_mutation_count": {"const": 163},
        "route_case_count": {"const": 60},
        "fallback_route_reached": {"const": true},
        "support_assignment_count": {"const": 0},
        "external_effect_count": {"const": 0}
      }
    },
    "source_result_refinement": {
      "type": "object",
      "required": ["counts", "sha256"],
      "properties": {
        "counts": {"type": "object"},
        "sha256": {"type": "object", "minProperties": 4, "maxProperties": 4, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "route_cases": {"type": "array", "minItems": 60, "maxItems": 60, "items": {"type": "object", "required": ["case_id", "stage", "expected_route", "actual_route", "accepted"]}},
    "mutation_receipts": {"type": "array", "minItems": 163, "maxItems": 163, "items": {"type": "object", "required": ["mutation_id", "rejected"]}},
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_stage", "receipt_count", "generation_count", "verification_count", "fallback_count", "migration_count", "consumption_count", "support_assignment_count", "external_effect_count"],
      "properties": {
        "terminal_stage": {"const": "closed"},
        "receipt_count": {"const": 8},
        "generation_count": {"const": 1},
        "verification_count": {"const": 1},
        "fallback_count": {"const": 1},
        "migration_count": {"const": 1},
        "consumption_count": {"const": 1},
        "support_assignment_count": {"const": 0},
        "external_effect_count": {"const": 0}
      }
    },
    "verification": {"type": "object", "required": ["lean", "result"]},
    "support_state_effect": {"const": "none"},
    "external_effect": {"const": "none"},
    "residuals": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "non_claims": {"type": "array", "minItems": 3, "items": {"type": "string"}}
  }
}
