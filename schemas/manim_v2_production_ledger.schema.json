{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corbensorenson.github.io/asi-stack-book/schemas/manim_v2_production_ledger.schema.json",
  "title": "ASI Stack Generation-Two Visual Production Ledger",
  "type": "object",
  "required": [
    "schema_version", "edition_id", "generated_at_utc", "book_structure_path",
    "book_structure_sha256", "visual_manifest_path", "visual_manifest_sha256",
    "authoring_standard_path", "authoring_standard_sha256", "authoring_bundle_sha256",
    "authoring_component_sha256", "treatment_schema_path",
    "treatment_schema_sha256", "beat_plan_schema_path", "beat_plan_schema_sha256",
    "experience_review_schema_path", "experience_review_schema_sha256",
    "review_context_schema_path", "review_context_schema_sha256",
    "av_diagnostics_schema_path", "av_diagnostics_schema_sha256",
    "frame_sample_manifest_schema_path", "frame_sample_manifest_schema_sha256",
    "render_receipt_schema_path", "render_receipt_schema_sha256",
    "sandbox_policy_receipt_schema_path", "sandbox_policy_receipt_schema_sha256",
    "narration_toolchain_path", "narration_toolchain_sha256",
    "visual_grammar_path", "visual_grammar_sha256", "visual_toolchain_path",
    "visual_toolchain_sha256", "primitive_library_path", "primitive_library_sha256",
    "scene_source_auditor_path", "scene_source_auditor_sha256",
    "isolated_render_runner_path", "isolated_render_runner_sha256",
    "primitive_regression_manifest_path", "primitive_regression_manifest_sha256",
    "primitive_regression_bundle_sha256", "canonical_chapter_count",
    "target_generation", "cohorts", "acceptance_contract", "counts", "entries",
    "support_state_effect", "publication_effect", "non_claim"
  ],
  "properties": {
    "schema_version": {"const": "asi_stack.manim_v2_production_ledger.v3"},
    "edition_id": {"const": "asi-stack-p7.3-visual-edition"},
    "generated_at_utc": {"type": "string"},
    "book_structure_path": {"const": "book_structure.json"},
    "book_structure_sha256": {"$ref": "#/$defs/digest"},
    "visual_manifest_path": {"const": "visual_edition/manifest.json"},
    "visual_manifest_sha256": {"$ref": "#/$defs/digest"},
    "authoring_standard_path": {"const": "skills/asi-stack-manim-videos/SKILL.md"},
    "authoring_standard_sha256": {"$ref": "#/$defs/digest"},
    "authoring_bundle_sha256": {"$ref": "#/$defs/digest"},
    "authoring_component_sha256": {
      "type": "object",
      "minProperties": 10,
      "propertyNames": {"pattern": "^skills/asi-stack-manim-videos/(references/.+\\.md|scripts/.+\\.py)$"},
      "additionalProperties": {"$ref": "#/$defs/digest"}
    },
    "treatment_schema_path": {"const": "schemas/manim_treatment.schema.json"},
    "treatment_schema_sha256": {"$ref": "#/$defs/digest"},
    "beat_plan_schema_path": {"const": "schemas/manim_beat_plan.schema.json"},
    "beat_plan_schema_sha256": {"$ref": "#/$defs/digest"},
    "experience_review_schema_path": {"const": "schemas/manim_experience_review.schema.json"},
    "experience_review_schema_sha256": {"$ref": "#/$defs/digest"},
    "review_context_schema_path": {"const": "schemas/manim_review_context_manifest.schema.json"},
    "review_context_schema_sha256": {"$ref": "#/$defs/digest"},
    "av_diagnostics_schema_path": {"const": "schemas/manim_av_diagnostics.schema.json"},
    "av_diagnostics_schema_sha256": {"$ref": "#/$defs/digest"},
    "frame_sample_manifest_schema_path": {"const": "schemas/manim_frame_sample_manifest.schema.json"},
    "frame_sample_manifest_schema_sha256": {"$ref": "#/$defs/digest"},
    "render_receipt_schema_path": {"const": "schemas/manim_render_receipt.schema.json"},
    "render_receipt_schema_sha256": {"$ref": "#/$defs/digest"},
    "sandbox_policy_receipt_schema_path": {"const": "schemas/manim_sandbox_policy_receipt.schema.json"},
    "sandbox_policy_receipt_schema_sha256": {"$ref": "#/$defs/digest"},
    "narration_toolchain_path": {"const": "visual_edition/narration_toolchain.json"},
    "narration_toolchain_sha256": {"$ref": "#/$defs/digest"},
    "visual_grammar_path": {"const": "visual_edition/visual_grammar.json"},
    "visual_grammar_sha256": {"$ref": "#/$defs/digest"},
    "visual_toolchain_path": {"const": "visual_edition/toolchain.json"},
    "visual_toolchain_sha256": {"$ref": "#/$defs/digest"},
    "primitive_library_path": {"const": "visual_edition/lib/asi_visuals.py"},
    "primitive_library_sha256": {"$ref": "#/$defs/digest"},
    "scene_source_auditor_path": {"const": "skills/asi-stack-manim-videos/scripts/audit_scene_source.py"},
    "scene_source_auditor_sha256": {"$ref": "#/$defs/digest"},
    "isolated_render_runner_path": {"const": "skills/asi-stack-manim-videos/scripts/render_scene_isolated.py"},
    "isolated_render_runner_sha256": {"$ref": "#/$defs/digest"},
    "primitive_regression_manifest_path": {"const": "visual_edition/primitive_regression_manifest.json"},
    "primitive_regression_manifest_sha256": {"$ref": "#/$defs/digest"},
    "primitive_regression_bundle_sha256": {"$ref": "#/$defs/digest"},
    "canonical_chapter_count": {"type": "integer", "minimum": 1, "maximum": 1000},
    "target_generation": {"const": 2},
    "cohorts": {
      "type": "object",
      "required": ["owner_reviewed_remediation", "withdrawn_predecessor_previews", "current_unlisted_previews", "not_yet_uploaded"],
      "properties": {
        "owner_reviewed_remediation": {"$ref": "#/$defs/unique_strings"},
        "withdrawn_predecessor_previews": {"$ref": "#/$defs/unique_strings"},
        "current_unlisted_previews": {"$ref": "#/$defs/unique_strings"},
        "not_yet_uploaded": {"$ref": "#/$defs/unique_strings"}
      },
      "additionalProperties": false
    },
    "acceptance_contract": {
      "type": "object",
      "required": [
        "required_passes", "experience_dimensions", "minimum_score_each_scored_dimension",
        "minimum_frame_samples_per_beat", "average_may_hide_failure", "forced_alignment_required",
        "source_aware_release_review_required", "cold_independent_proxy_required",
        "cold_proxy_is_human_learning_evidence", "external_human_prepublication_gate_required",
        "scene_source_preflight_required", "isolated_render_execution_required",
        "primitive_graphical_regression_required"
      ],
      "properties": {
        "required_passes": {"const": ["animatic", "picture_and_sound_lock", "release_candidate", "independent_release_candidate"]},
        "experience_dimensions": {"const": ["teaching_clarity", "composition", "motion_quality", "synchronization", "continuity", "pacing", "voice", "sound_mix", "engagement", "accessibility", "claim_fidelity"]},
        "minimum_score_each_scored_dimension": {"const": 4},
        "minimum_frame_samples_per_beat": {"const": 5},
        "average_may_hide_failure": {"const": false},
        "forced_alignment_required": {"const": true},
        "source_aware_release_review_required": {"const": true},
        "cold_independent_proxy_required": {"const": true},
        "cold_proxy_is_human_learning_evidence": {"const": false},
        "external_human_prepublication_gate_required": {"const": false},
        "scene_source_preflight_required": {"const": true},
        "isolated_render_execution_required": {"const": true},
        "primitive_graphical_regression_required": {"const": true}
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["planned", "narration_draft", "treated", "script_passed", "beat_planned", "animatic_passed", "picture_and_sound_lock_passed", "release_candidate_passed", "independent_release_candidate_passed", "accepted_generation_2", "youtube_predecessors", "youtube_generation_2_unlisted_preview", "youtube_generation_2_current", "quarto_generation_2_current"],
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 1000}
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["position", "chapter_id", "title", "chapter_path", "chapter_sha256", "source_context_sha256", "cohort", "predecessor", "target"],
        "properties": {
          "position": {"type": "integer", "minimum": 1, "maximum": 1000},
          "chapter_id": {"type": "string"},
          "title": {"type": "string"},
          "chapter_path": {"type": "string", "pattern": "^chapters/.+\\.qmd$"},
          "chapter_sha256": {"$ref": "#/$defs/digest"},
          "source_context_sha256": {"$ref": "#/$defs/digest"},
          "cohort": {"enum": ["owner_reviewed_remediation", "withdrawn_predecessor_previews", "current_unlisted_previews", "not_yet_uploaded"]},
          "predecessor": {
            "type": ["object", "null"],
            "required": ["local_generation", "packet_path", "master_path", "master_sha256", "custody_state", "youtube_video_id", "youtube_visibility", "preserve_history"],
            "properties": {
              "local_generation": {"const": 1},
              "packet_path": {"type": "string"},
              "master_path": {"type": "string"},
              "master_sha256": {"$ref": "#/$defs/digest"},
              "custody_state": {"enum": ["local_only", "unlisted_preview_bound", "private_historical_withdrawn"]},
              "youtube_video_id": {"type": ["string", "null"]},
              "youtube_visibility": {"enum": ["not_uploaded", "unlisted", "private"]},
              "withdrawn_at_utc": {"type": "string"},
              "history_record_path": {"const": "visual_edition/youtube_preview_history_2026-07-30.json"},
              "preserve_history": {"const": true}
            },
            "additionalProperties": false
          },
          "target": {
            "type": "object",
            "required": [
              "generation", "stage", "treatment_path", "treatment_sha256",
              "beat_plan_path", "beat_plan_sha256", "scene_path", "scene_sha256",
              "narration_path", "narration_sha256", "caption_path", "caption_sha256",
              "transcript_path", "transcript_sha256", "thumbnail_path", "thumbnail_sha256",
              "master_path", "master_sha256", "render_receipt_path", "render_receipt_sha256",
              "experience_review_paths", "gates", "youtube_state", "youtube_video_id", "quarto_embed_state"
            ],
            "properties": {
              "generation": {"const": 2},
              "stage": {"enum": ["planned", "narration_draft", "treated", "script_passed", "beat_planned", "animatic", "picture_and_sound_lock", "release_candidate", "accepted", "youtube_current", "quarto_current"]},
              "treatment_path": {"type": "string"},
              "treatment_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
              "beat_plan_path": {"type": "string"},
              "beat_plan_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
              "scene_path": {"type": "string"},
              "scene_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
              "narration_path": {"type": "string"},
              "narration_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
              "caption_path": {"type": "string"},
              "caption_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
              "transcript_path": {"type": "string"},
              "transcript_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
              "thumbnail_path": {"type": "string"},
              "thumbnail_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
              "master_path": {"type": "string"},
              "master_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
              "render_receipt_path": {"type": "string"},
              "render_receipt_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
              "experience_review_paths": {
                "type": "object",
                "required": ["animatic", "picture_and_sound_lock", "release_candidate", "independent_release_candidate"],
                "additionalProperties": {"type": "string"}
              },
              "gates": {
                "type": "object",
                "required": ["treatment", "script", "beat_plan", "animatic", "picture_and_sound_lock", "release_candidate", "independent_release_candidate", "technical", "claim_fidelity", "accepted"],
                "additionalProperties": {"enum": ["not_started", "in_progress", "revise", "pass"]}
              },
              "youtube_state": {"enum": ["not_ready", "ready_for_authorized_supersession", "unlisted_reconciled", "public_current"]},
              "youtube_video_id": {"type": ["string", "null"]},
              "quarto_embed_state": {"enum": ["predecessor_preview", "absent", "generation_2_current"]}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "support_state_effect": {"const": "none"},
    "publication_effect": {"const": "none"},
    "non_claim": {"type": "string", "minLength": 40}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unique_strings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
