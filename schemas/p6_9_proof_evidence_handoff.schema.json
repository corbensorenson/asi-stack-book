{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P6.9 Exact Proof and Evidence Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "recorded_date",
    "state",
    "source_contract",
    "raw_scaffold_exit",
    "w3_binding",
    "chapter_records",
    "summary",
    "consumer",
    "support_state_effect",
    "release_effect",
    "non_claims"
  ],
  "properties": {
    "schema_version": { "const": "asi_stack.p6_9_proof_evidence_handoff.v1" },
    "handoff_id": { "const": "P6.9-R21-exact-proof-evidence-handoff" },
    "recorded_date": { "const": "2026-07-28" },
    "state": { "const": "terminal_complete" },
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "contract_id"],
      "properties": {
        "path": { "const": "evidence_quality/chapter_substance_contract.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "contract_id": { "const": "P6.9-R21-concept-complete-depth-and-atom-adequacy" }
      }
    },
    "raw_scaffold_exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "state", "unjustified_widest_block_count", "exit_passed"],
      "properties": {
        "path": { "const": "evidence_quality/p6_9_raw_scaffold_ownership_audit.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "state": { "const": "terminal_complete" },
        "unjustified_widest_block_count": { "const": 0 },
        "exit_passed": { "const": true }
      }
    },
    "w3_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "state", "reader_facing_repeated_12_gram_count"],
      "properties": {
        "path": { "const": "evidence_quality/p7_1a_w3_inheritance_guard.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "state": { "const": "terminal_complete" },
        "reader_facing_repeated_12_gram_count": { "const": 0 }
      }
    },
    "chapter_records": {
      "type": "array",
      "minItems": 23,
      "maxItems": 23,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chapter_id",
          "chapter_title",
          "chapter_path",
          "chapter_sha256",
          "semantic_review_sha256",
          "semantic_review_date",
          "concept_count",
          "concepts"
        ],
        "properties": {
          "chapter_id": { "type": "string", "minLength": 1 },
          "chapter_title": { "type": "string", "minLength": 1 },
          "chapter_path": { "type": "string", "minLength": 1 },
          "chapter_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "semantic_review_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "semantic_review_date": { "type": "string", "minLength": 1 },
          "concept_count": { "const": 8 },
          "concepts": {
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "concept_id",
                "heading",
                "source_ids",
                "atom_refs",
                "atom_ownership_rationale",
                "semantic_review_disposition",
                "support_state_effect"
              ],
              "properties": {
                "concept_id": { "type": "string", "minLength": 1 },
                "heading": { "type": "string", "minLength": 1 },
                "source_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "atom_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "atom_id",
                      "atom_source_path",
                      "owner",
                      "proposition",
                      "falsifier",
                      "evidence_lanes",
                      "evidence_route",
                      "maximum_inference",
                      "unresolved_challenge",
                      "support_state"
                    ],
                    "properties": {
                      "atom_id": { "type": "string", "minLength": 1 },
                      "atom_source_path": { "type": "string", "minLength": 1 },
                      "owner": { "type": "string", "minLength": 1 },
                      "proposition": { "type": "string", "minLength": 1 },
                      "falsifier": { "type": "string", "minLength": 1 },
                      "evidence_lanes": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "type": "string", "minLength": 1 }
                      },
                      "evidence_route": { "type": "string", "minLength": 1 },
                      "maximum_inference": { "type": "string", "minLength": 1 },
                      "unresolved_challenge": { "type": "string", "minLength": 1 },
                      "support_state": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "atom_ownership_rationale": { "type": "string", "minLength": 1 },
                "semantic_review_disposition": { "const": "accepted_for_editorial_substance_no_evidence_effect" },
                "support_state_effect": { "const": "none" }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_count",
        "concept_count",
        "concepts_with_source_identity_count",
        "concepts_with_atom_identity_count",
        "atom_mapping_count",
        "concepts_with_falsifier_count",
        "concepts_with_evidence_lane_count",
        "concepts_with_maximum_inference_count",
        "concepts_with_unresolved_challenge_count",
        "missing_handoff_identity_count",
        "support_state_effect"
      ],
      "properties": {
        "chapter_count": { "const": 23 },
        "concept_count": { "const": 184 },
        "concepts_with_source_identity_count": { "const": 184 },
        "concepts_with_atom_identity_count": { "const": 184 },
        "atom_mapping_count": { "type": "integer", "minimum": 184 },
        "concepts_with_falsifier_count": { "const": 184 },
        "concepts_with_evidence_lane_count": { "const": 184 },
        "concepts_with_maximum_inference_count": { "const": 184 },
        "concepts_with_unresolved_challenge_count": { "const": 184 },
        "missing_handoff_identity_count": { "const": 0 },
        "support_state_effect": { "const": "none" }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "activation_rule", "required_identity_fields"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "activation_rule": { "type": "string", "minLength": 1 },
        "required_identity_fields": {
          "const": [
            "chapter_identity",
            "concept_identity",
            "atom_identity",
            "source_identity",
            "falsifier",
            "evidence_lane",
            "maximum_inference",
            "unresolved_challenge"
          ]
        }
      }
    },
    "support_state_effect": { "const": "none" },
    "release_effect": { "const": "none" },
    "non_claims": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
