{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corbensorenson.github.io/asi-stack-book/schemas/manim_beat_plan.schema.json",
  "title": "ASI Stack Manim Audio-Timed Semantic Beat Plan",
  "type": "object",
  "required": [
    "schema_version",
    "chapter_id",
    "chapter_sha256",
    "source_commit",
    "treatment_path",
    "treatment_sha256",
    "narration_path",
    "narration_sha256",
    "target_duration_seconds",
    "timing",
    "beats"
  ],
  "properties": {
    "schema_version": {"const": "asi_stack.manim_beat_plan.v4"},
    "chapter_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "chapter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "treatment_path": {"type": "string", "minLength": 8},
    "treatment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "narration_path": {"type": "string", "minLength": 8},
    "narration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_duration_seconds": {"type": "number", "minimum": 1},
    "timing": {
      "type": "object",
      "required": [
        "state",
        "source",
        "receipt_path",
        "receipt_sha256",
        "narration_receipt_path",
        "narration_receipt_sha256",
        "narration_verification_report_path",
        "narration_verification_report_sha256",
        "aligner_id",
        "manual_anchor_review_path",
        "manual_anchor_review_sha256",
        "manual_anchor_reviewer_id",
        "manual_anchor_count",
        "manual_anchor_failures"
      ],
      "properties": {
        "state": {"enum": ["estimated", "block_timed", "forced_aligned"]},
        "source": {"enum": ["editorial_estimate", "synthesis_receipt", "forced_alignment_receipt"]},
        "receipt_path": {"type": ["string", "null"], "minLength": 8},
        "receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "narration_receipt_path": {"type": ["string", "null"], "minLength": 8},
        "narration_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "narration_verification_report_path": {"type": ["string", "null"], "minLength": 8},
        "narration_verification_report_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "aligner_id": {"type": ["string", "null"], "minLength": 3},
        "manual_anchor_review_path": {"type": ["string", "null"], "minLength": 8},
        "manual_anchor_review_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "manual_anchor_reviewer_id": {"type": ["string", "null"], "minLength": 3},
        "manual_anchor_count": {"type": ["integer", "null"], "minimum": 1},
        "manual_anchor_failures": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "beats": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "macro_move_id",
          "performance_block_id",
          "story_function",
          "mode",
          "start_seconds",
          "end_seconds",
          "narration",
          "sync_anchor",
          "visual_purpose",
          "visual_action",
          "attention_target",
          "semantic_encodings",
          "object_before",
          "object_after",
          "continuity_objects",
          "composition",
          "motion_curve",
          "camera_action",
          "animation_techniques",
          "on_screen_text",
          "settle_seconds",
          "hold_purpose",
          "introduced_terms",
          "claim_role",
          "source_refs",
          "visual_inference",
          "evidence_boundary"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^b[0-9]{2,3}$"},
          "macro_move_id": {"type": "string", "pattern": "^m[0-9]{2}$"},
          "performance_block_id": {"type": "string", "pattern": "^p[0-9]{2}$"},
          "story_function": {
            "enum": [
              "hook",
              "setup",
              "prediction",
              "construction",
              "mechanism",
              "worked_trace",
              "comparison",
              "counterexample",
              "failure",
              "consequence",
              "evidence_boundary",
              "payoff"
            ]
          },
          "mode": {"enum": ["change", "hold"]},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "narration": {"type": "string", "minLength": 2},
          "sync_anchor": {"type": "string", "minLength": 3},
          "visual_purpose": {"type": "string", "minLength": 8},
          "visual_action": {"type": "string", "minLength": 8},
          "attention_target": {"type": "string", "minLength": 8},
          "semantic_encodings": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "identity",
                "relation",
                "causality",
                "sequence",
                "quantity",
                "uncertainty",
                "contrast",
                "containment",
                "authority",
                "rollback",
                "attention"
              ]
            }
          },
          "object_before": {"type": "string", "minLength": 8},
          "object_after": {"type": "string", "minLength": 8},
          "continuity_objects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 2}
          },
          "composition": {"type": "string", "minLength": 8},
          "motion_curve": {"type": "string", "minLength": 8},
          "camera_action": {"type": "string", "minLength": 8},
          "animation_techniques": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 2}
          },
          "on_screen_text": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 48}
          },
          "settle_seconds": {"type": "number", "minimum": 0},
          "hold_purpose": {"type": ["string", "null"], "minLength": 8},
          "introduced_terms": {
            "type": "array",
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "claim_role": {
            "enum": [
              "question",
              "concrete_example",
              "mechanism",
              "transition",
              "counterexample",
              "evidence",
              "boundary",
              "connective"
            ]
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 3}
          },
          "visual_inference": {"type": "string", "minLength": 8},
          "evidence_boundary": {"type": "string", "minLength": 8},
          "question_id": {"type": "string", "minLength": 1},
          "reasoning_pause_seconds": {"type": "number", "minimum": 0},
          "resolves_question_id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
